841">ゆ</span><span begin="02:39.121" end="02:39.689">けんり</span><span begin="02:40.257" end="02:40.857">わたし</span></text><text for="L38"><span begin="02:44.449" end="02:44.873">おも</span></text><text for="L39"><span begin="02:47.976" end="02:48.296">おも</span></text><text for="L40"><span begin="02:53.788" end="02:54.380">のど</span><span begin="02:54.732" end="02:55.228">かわ</span> <span begin="02:56.276" end="02:56.964">おし</span></text><text for="L42"><span begin="03:00.894" end="03:01.070">お</span><span begin="03:02.142" end="03:02.502">はじ</span></text><text for="L43"><span begin="03:03.785" end="03:04.913">さんざん</span><span begin="03:04.913" end="03:05.284">なや</span></text><text for="L44"><span begin="03:07.139" end="03:07.563">こと</span></text><text for="L45"><span begin="03:08.884" end="03:09.273">よそお</span><span begin="03:10.084" end="03:10.604">せいこう</span></text><text for="L46"><span begin="03:11.372" end="03:11.764">きみ</span><span begin="03:11.948" end="03:12.459">ちょうし</span></text></transliteration></transliterations></iTunesMetadata></metadata></head><body dur="03:14.141"><div begin="00:00.498" end="03:14.141"><p begin="00:00.498" end="00:03.074" ttm:agent="v1" itunes:key="L1"><span begin="00:00.498" end="00:00.670">あ</span><span begin="00:00.670" end="00:00.842">ん</span><span begin="00:00.842" end="00:01.082">な</span><span begin="00:01.082" end="00:01.362">風</span><span begin="00:01.362" end="00:01.586">に</span><span begin="00:01.586" end="00:02.107">笑</span><span begin="00:02.107" end="00:02.238">う</span><span begin="00:02.238" end="00:02.369">ん</span><span begin="00:02.370" end="00:02.642">だ</span><span begin="00:02.642" end="00:03.074">ね</span><span ttm:role="x-translation" xml:lang="zh-CN">原来你也会这样笑啊</span></p><p begin="00:03.075" end="00:05.300" ttm:agent="v1" itunes:key="L2"><span begin="00:03.075" end="00:03.627">私</span><span begin="00:03.627" end="00:03.763">に</span><span begin="00:03.763" end="00:03.987">は</span><span begin="00:03.987" end="00:04.155">見</span><span begin="00:04.155" end="00:04.347">せ</span><span begin="00:04.347" end="00:04.555">な</span><span begin="00:04.555" end="00:04.820">い</span><span begin="00:04.820" end="00:05.011">け</span><span begin="00:05.011" end="00:05.300">ど</span><span ttm:role="x-translation" xml:lang="zh-CN">虽然我是没法看到了</span></p><p begin="00:05.491" end="00:07.860" ttm:agent="v1" itunes:key="L3"><span begin="00:05.491" end="00:05.900">Oh </span><span begin="00:05.900" end="00:06.211">my </span><span begin="00:06.211" end="00:06.619">girl </span><span begin="00:06.619" end="00:07.091">little </span><span begin="00:07.091" end="00:07.860">angel</span></p><p begin="00:08.091" end="00:10.281" ttm:agent="v1" itunes:key="L4"><span begin="00:08.091" end="00:08.459">No </span><span begin="00:08.459" end="00:08.787">say </span><span begin="00:08.787" end="00:09.064">I </span><span begin="00:09.064" end="00:09.232">love </span><span begin="00:09.232" end="00:09.608">you </span><span begin="00:09.608" end="00:10.281">tonight</span></p><p begin="00:10.281" end="00:15.493" ttm:agent="v1" itunes:key="L5"><span begin="00:10.281" end="00:10.705">切</span><span begin="00:10.705" end="00:11.145">な</span><span begin="00:11.145" end="00:11.441">い</span><span begin="00:11.441" end="00:11.585">か</span><span begin="00:11.585" end="00:11.809">ら</span> <span begin="00:12.009" end="00:12.497">あ</span><span begin="00:12.497" end="00:12.969">の</span><span begin="00:12.969" end="00:13.417">人</span><span begin="00:13.417" end="00:13.713">の</span><span begin="00:13.713" end="00:14.508">話</span><span begin="00:14.508" end="00:14.668">は</span><span begin="00:14.668" end="00:15.012">後</span><span begin="00:15.012" end="00:15.268">回</span><span begin="00:15.268" end="00:15.493">し</span><span ttm:role="x-translation" xml:lang="zh-CN">太烦了 那人说的话之后再回复吧</span></p><p begin="00:15.703" end="00:20.743" ttm:agent="v1" itunes:key="L6"><span begin="00:15.703" end="00:16.607">私</span><span begin="00:16.607" end="00:17.119">の</span><span begin="00:18.311" end="00:18.937">心臓</span><span begin="00:18.937" end="00:19.097">言</span><span begin="00:19.097" end="00:19.417">う</span><span begin="00:19.417" end="00:19.601">こ</span><span begin="00:19.601" end="00:19.753">と</span><span begin="00:19.753" end="00:20.106">を</span><span begin="00:20.106" end="00:20.318">聞</span><span begin="00:20.318" end="00:20.530">い</span><span begin="00:20.530" end="00:20.743">て</span><span ttm:role="x-translation" xml:lang="zh-CN">听听来自我心脏的话语吧</span></p><p begin="00:40.133" end="00:42.511" ttm:agent="v1" itunes:key="L7"><span begin="00:40.133" end="00:40.533">胸</span><span begin="00:40.533" end="00:40.709">に</span><span begin="00:40.709" end="00:40.893">空</span><span begin="00:40.893" end="00:41.133">い</span><span begin="00:41.133" end="00:41.454">た</span><span begin="00:41.454" end="00:41.626">ぽ</span><span begin="00:41.626" end="00:41.798">っ</span><span begin="00:41.798" end="00:41.974">か</span><span begin="00:41.974" end="00:42.198">り</span><span begin="00:42.198" end="00:42.511">と</span><span ttm:role="x-translation" xml:lang="zh-CN">胸腔分明空虚不已</span></p><p begin="00:42.734" end="00:45.147" ttm:agent="v1" itunes:key="L8"><span begin="00:42.734" end="00:43.302">慰</span><span begin="00:43.302" end="00:43.446">め</span><span begin="00:43.446" end="00:43.630">な</span><span begin="00:43.630" end="00:44.010">ど</span><span begin="00:44.010" end="00:44.202">い</span><span begin="00:44.202" end="00:44.410">ら</span><span begin="00:44.410" end="00:44.554">ぬ</span><span begin="00:44.554" end="00:45.147">と</span><span ttm:role="x-translation" xml:lang="zh-CN">却坦然说着</span></p><p begin="00:45.147" end="00:46.587" ttm:agent="v1" itunes:key="L9"><span begin="00:45.147" end="00:45.819">堂々</span><span begin="00:45.819" end="00:46.075">と</span><span begin="00:46.075" end="00:46.243">し</span><span begin="00:46.243" end="00:46.427">て</span><span begin="00:46.427" end="00:46.587">る</span><span ttm:role="x-translation" xml:lang="zh-CN">不需要任何安慰</span></p><p begin="00:46.587" end="00:48.771" ttm:agent="v1" itunes:key="L10"><span begin="00:46.587" end="00:46.803">Oh </span><span begin="00:46.803" end="00:47.027">my </span><span begin="00:47.027" end="00:47.387">girl </span><span begin="00:47.387" end="00:47.899">little </span><span begin="00:47.899" end="00:48.771">angel</span></p><p begin="00:48.971" end="00:51.068" ttm:agent="v1" itunes:key="L11"><span begin="00:48.971" end="00:49.411">誰</span><span begin="00:49.411" end="00:49.611">も</span><span begin="00:49.611" end="00:49.771">が</span><span begin="00:49.771" end="00:49.947">気</span><span begin="00:49.947" end="00:50.091">に</span><span begin="00:50.091" end="00:50.275">な</span><span begin="00:50.275" end="00:50.459">っ</span><span begin="00:50.459" end="00:50.631">て</span><span begin="00:50.631" end="00:50.803">い</span><span begin="00:50.803" end="00:51.068">る</span><span ttm:role="x-translation" xml:lang="zh-CN">任谁都会非常在意</span></p><p begin="00:51.068" end="00:53.867" ttm:agent="v1" itunes:key="L12"><span begin="00:51.068" end="00:51.563">私</span><span begin="00:51.563" end="00:51.851">も</span><span begin="00:52.163" end="00:52.419">そ</span><span begin="00:52.419" end="00:52.787">の</span><span begin="00:52.787" end="00:53.155">ひ</span><span begin="00:53.155" end="00:53.515">と</span><span begin="00:53.515" end="00:53.867">り</span><span ttm:role="x-translation" xml:lang="zh-CN">我也是其中之一</span></p><p begin="00:54.762" end="00:59.202" ttm:agent="v1" itunes:key="L13"><span begin="00:54.762" end="00:54.978">で</span><span begin="00:54.978" end="00:55.320">も</span><span begin="00:55.320" end="00:55.560">う</span><span begin="00:55.560" end="00:56.056">ま</span><span begin="00:56.056" end="00:56.232">く</span><span begin="00:56.232" end="00:56.408">い</span><span begin="00:56.408" end="00:56.560">く</span><span begin="00:56.560" end="00:56.732">よ</span><span begin="00:56.732" end="00:56.904">っ</span><span begin="00:56.904" end="00:58.616">て</span><span begin="00:58.616" end="00:58.840">言</span><span begin="00:58.840" end="00:59.202">う</span><span ttm:role="x-translation" xml:lang="zh-CN">但我也只是说 一切都会好起来的</span></p><p begin="01:00.239" end="01:01.151" ttm:agent="v1" itunes:key="L14"><span begin="01:00.239" end="01:00.305">う</span><span begin="01:00.306" end="01:00.372">ん、</span> <span begin="01:00.439" end="01:00.607">そ</span><span begin="01:00.607" end="01:00.767">れ</span><span begin="01:00.767" end="01:00.895">だ</span><span begin="01:00.895" end="01:01.151">け</span><span ttm:role="x-translation" xml:lang="zh-CN">只是 言尽于此</span></p><p begin="01:01.407" end="01:06.251" ttm:agent="v1" itunes:key="L15"><span begin="01:01.407" end="01:02.119">喉</span><span begin="01:02.119" end="01:02.479">が</span><span begin="01:02.479" end="01:02.859">渇</span><span begin="01:02.859" end="01:03.107">い</span><span begin="01:03.107" end="01:03.259">た</span><span begin="01:03.259" end="01:03.659">ら</span> <span begin="01:03.987" end="01:04.659">教</span><span begin="01:04.659" end="01:05.026">え</span><span begin="01:05.026" end="01:05.202">て</span><span begin="01:05.202" end="01:05.467">あ</span><span begin="01:05.467" end="01:05.779">げ</span><span begin="01:05.779" end="01:05.955">る</span><span begin="01:05.955" end="01:06.251">よ</span><span ttm:role="x-translation" xml:lang="zh-CN">要是喉咙渴了 让我教教你</span></p><p begin="01:06.389" end="01:08.566" ttm:agent="v1" itunes:key="L16"><span begin="01:06.389" end="01:06.573">ス</span><span begin="01:06.573" end="01:06.741">ト</span><span begin="01:06.741" end="01:06.909">ロ</span><span begin="01:06.909" end="01:07.061">ベ</span><span begin="01:07.061" end="01:07.149">リ</span><span begin="01:07.149" end="01:07.237">ー</span><span begin="01:07.237" end="01:07.381">ア</span><span begin="01:07.381" end="01:07.549">イ</span><span begin="01:07.549" end="01:07.677">ス</span><span begin="01:07.677" end="01:07.805">と</span><span begin="01:07.805" end="01:07.909">シ</span><span begin="01:07.909" end="01:08.077">ガ</span><span begin="01:08.077" end="01:08.221">レ</span><span begin="01:08.221" end="01:08.365">ッ</span><span begin="01:08.365" end="01:08.566">ト</span><span ttm:role="x-translation" xml:lang="zh-CN">草莓冰淇凌还有香烟</span></p><p begin="01:08.566" end="01:11.424" ttm:agent="v1" itunes:key="L17"><span begin="01:08.566" end="01:08.726">終</span><span begin="01:08.726" end="01:08.990">わ</span><span begin="01:08.990" end="01:09.158">り</span><span begin="01:09.158" end="01:09.342">で</span><span begin="01:09.342" end="01:09.502">は</span><span begin="01:09.502" end="01:09.654">な</span><span begin="01:09.654" end="01:09.830">く</span><span begin="01:09.830" end="01:10.166">始</span><span begin="01:10.166" end="01:10.310">ま</span><span begin="01:10.310" end="01:10.797">り</span><span begin="01:10.797" end="01:10.989">だ</span><span begin="01:10.989" end="01:11.189">か</span><span begin="01:11.189" end="01:11.424">ら</span><span ttm:role="x-translation" xml:lang="zh-CN">并非结束 而是一切的开始</span></p><p begin="01:11.424" end="01:16.314" ttm:agent="v1" itunes:key="L18"><span begin="01:11.424" end="01:11.927">先</span><span begin="01:11.927" end="01:12.608">回</span><span begin="01:12.608" end="01:12.855">り</span><span begin="01:12.855" end="01:13.055">し</span><span begin="01:13.055" end="01:13.201">と</span><span begin="01:13.201" end="01:13.385">い</span><span begin="01:13.385" end="01:13.521">て</span><span begin="01:13.521" end="01:13.794">さ</span> <span begin="01:14.018" end="01:14.361">ま</span><span begin="01:14.361" end="01:14.537">る</span><span begin="01:14.537" end="01:14.753">で</span><span begin="01:14.753" end="01:15.865">完璧</span><span begin="01:15.865" end="01:16.314">を</span><span ttm:role="x-translation" xml:lang="zh-CN">那我先抢先一步 仿佛无懈可击</span></p><p begin="01:16.553" end="01:19.019" ttm:agent="v1" itunes:key="L19"><span begin="01:16.553" end="01:17.009">装</span><span begin="01:17.009" end="01:17.129">う</span><span begin="01:17.129" end="01:17.361">こ</span><span begin="01:17.361" end="01:17.529">と</span><span begin="01:17.529" end="01:17.721">に</span><span begin="01:17.721" end="01:17.921">は</span><span begin="01:17.921" end="01:18.337">成功</span><span begin="01:18.337" end="01:18.489">し</span><span begin="01:18.489" end="01:18.673">た</span><span begin="01:18.673" end="01:18.857">っ</span><span begin="01:18.857" end="01:19.019">て</span><span ttm:role="x-translation" xml:lang="zh-CN">明明虚饰伪装已经成功</span></p><p begin="01:19.019" end="01:21.827" ttm:agent="v1" itunes:key="L20"><span begin="01:19.019" end="01:19.386">君</span><span begin="01:19.386" end="01:19.563">の</span><span begin="01:19.563" end="01:19.907">興味</span><span begin="01:19.907" end="01:20.115">は</span><span begin="01:20.115" end="01:20.579">次</span><span begin="01:20.579" end="01:20.859">の</span><span begin="01:21.051" end="01:21.827">話</span><span ttm:role="x-translation" xml:lang="zh-CN">你的兴趣下次再说</span></p><p begin="01:31.268" end="01:33.652" ttm:agent="v1" itunes:key="L21"><span begin="01:31.268" end="01:31.420">な</span><span begin="01:31.420" end="01:31.572">ん</span><span begin="01:31.572" end="01:31.772">と</span><span begin="01:31.772" end="01:31.932">な</span><span begin="01:31.932" end="01:32.116">く</span><span begin="01:32.116" end="01:32.508">が</span><span begin="01:32.508" end="01:32.876">続</span><span begin="01:32.876" end="01:33.188">い</span><span begin="01:33.188" end="01:33.356">て</span><span begin="01:33.356" end="01:33.652">る</span><span ttm:role="x-translation" xml:lang="zh-CN">漫不经心地继续着</span></p><p begin="01:33.749" end="01:36.141" ttm:agent="v1" itunes:key="L22"><span begin="01:33.749" end="01:33.957">分</span><span begin="01:33.957" end="01:34.149">け</span><span begin="01:34.149" end="01:34.509">隔</span><span begin="01:34.509" end="01:34.701">て</span><span begin="01:34.701" end="01:34.942">な</span><span begin="01:34.942" end="01:35.173">い</span><span begin="01:35.173" end="01:35.365">と</span><span begin="01:35.365" end="01:35.573">こ</span><span begin="01:35.573" end="01:35.726">が</span><span begin="01:35.726" end="01:35.953">い</span><span begin="01:35.953" end="01:36.140">い</span><span ttm:role="x-translation" xml:lang="zh-CN">我却坦然地说</span></p><p begin="01:36.141" end="01:37.493" ttm:agent="v1" itunes:key="L23"><span begin="01:36.141" end="01:36.749">堂々</span><span begin="01:36.749" end="01:36.941">と</span><span begin="01:36.941" end="01:37.133">し</span><span begin="01:37.133" end="01:37.269">て</span><span begin="01:37.269" end="01:37.493">る</span><span ttm:role="x-translation" xml:lang="zh-CN">喜欢你一视同仁这点</span></p><p begin="01:37.493" end="01:39.858" ttm:agent="v1" itunes:key="L24"><span begin="01:37.493" end="01:37.717">Oh </span><span begin="01:37.717" end="01:38.125">my </span><span begin="01:38.125" end="01:38.434">girl </span><span begin="01:38.434" end="01:38.930">little </span><span begin="01:38.930" end="01:39.858">angel</span></p><p begin="01:39.858" end="01:42.253" ttm:agent="v1" itunes:key="L25"><span begin="01:39.858" end="01:40.082">こ</span><span begin="01:40.082" end="01:40.338">な</span><span begin="01:40.338" end="01:40.538">い</span><span begin="01:40.538" end="01:40.746">だ</span><span begin="01:40.746" end="01:40.862">聞</span><span begin="01:40.862" end="01:40.978">い</span><span begin="01:40.978" end="01:41.202">た</span><span begin="01:41.202" end="01:41.426">ん</span><span begin="01:41.426" end="01:41.625">だ</span><span begin="01:41.625" end="01:42.066">け</span><span begin="01:42.066" end="01:42.253">ど</span><span ttm:role="x-translation" xml:lang="zh-CN">我前阵子听说了</span></p><p begin="01:42.253" end="01:44.934" ttm:agent="v1" itunes:key="L26"><span begin="01:42.253" end="01:42.377">ど</span><span begin="01:42.377" end="01:42.501">う</span><span begin="01:42.501" end="01:42.645">し</span><span begin="01:42.645" end="01:43.028">て</span><span begin="01:43.300" end="01:44.036">断</span><span begin="01:44.036" end="01:44.284">っ</span><span begin="01:44.284" end="01:44.572">た</span><span begin="01:44.572" end="01:44.934">の</span><span ttm:role="x-translation" xml:lang="zh-CN">你为什么拒绝了呢</span></p><p begin="01:45.730" end="01:50.233" ttm:agent="v1" itunes:key="L27"><span begin="01:45.730" end="01:46.130">な</span><span begin="01:46.130" end="01:46.530">ん</span><span begin="01:46.530" end="01:46.843">て</span><span begin="01:46.843" end="01:47.562">結局</span><span begin="01:47.562" end="01:47.763">聞</span><span begin="01:47.763" end="01:48.641">け</span><span begin="01:49.585" end="01:49.897">な</span><span begin="01:49.897" end="01:50.233">い</span><span ttm:role="x-translation" xml:lang="zh-CN">我又为什么最后都没敢去问</span></p><p begin="01:52.521" end="01:57.263" ttm:agent="v1" itunes:key="L28"><span begin="01:52.521" end="01:52.945">喉</span><span begin="01:52.945" end="01:53.449">が</span><span begin="01:53.449" end="01:53.945">渇</span><span begin="01:53.945" end="01:54.118">い</span><span begin="01:54.118" end="01:54.278">た</span><span begin="01:54.278" end="01:54.679">ら</span> <span begin="01:54.958" end="01:55.646">教</span><span begin="01:55.646" end="01:56.006">え</span><span begin="01:56.006" end="01:56.215">て</span><span begin="01:56.215" end="01:56.494">あ</span><span begin="01:56.494" end="01:56.774">げ</span><span begin="01:56.774" end="01:56.958">る</span><span begin="01:56.958" end="01:57.263">よ</span><span ttm:role="x-translation" xml:lang="zh-CN">要是喉咙渴了 让我教教你</span></p><p begin="01:57.462" end="01:59.718" ttm:agent="v1" itunes:key="L29"><span begin="01:57.462" end="01:57.631">ス</span><span begin="01:57.631" end="01:57.806">ト</span><span begin="01:57.806" end="01:57.958">ロ</span><span begin="01:57.958" end="01:58.111">ベ</span><span begin="01:58.111" end="01:58.202">リ</span><span begin="01:58.202" end="01:58.293">ー</span><span begin="01:58.294" end="01:58.462">ア</span><span begin="01:58.462" end="01:58.622">イ</span><span begin="01:58.622" end="01:58.766">ス</span><span begin="01:58.766" end="01:58.902">と</span><span begin="01:58.902" end="01:59.062">シ</span><span begin="01:59.062" end="01:59.215">ガ</span><span begin="01:59.215" end=